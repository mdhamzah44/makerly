# ---------------------------------------------------------------------------
# 8-way MongoDB sharding (optional — matches the storefront app's SHARDING.md
# exactly; this admin reads/writes the same 8 shards + primary, so these
# must be the SAME values you set on the storefront/order-worker, in the
# SAME order). Only `orders` and `users` are wired up here — see the
# SHARDED_COLLECTIONS set in src/lib/admin-data.server.ts. Leave unset and
# the admin transparently falls back to the single MONGODB_URI cluster.
# ---------------------------------------------------------------------------

# Exactly 8, comma-separated, in a fixed order — never reorder once any
# data has been migrated, or shardIndexFor() silently reassigns every
# existing record to the wrong shard.
# MONGO_SHARD_URLS=<shard-0-uri>,<shard-1-uri>,<shard-2-uri>,<shard-3-uri>,<shard-4-uri>,<shard-5-uri>,<shard-6-uri>,<shard-7-uri>

# The old single-cluster database — read fallback + migration source only.
# MONGO_PRIMARY_URL=<atlas-cerulean-field-uri>
# MONGO_PRIMARY_CONNECTION_LIMIT=400
# MONGO_PRIMARY_MIGRATOR_RESERVE=10

# Pool-sizing knobs shard.server.ts uses (same meaning as in the storefront
# app's REDISSETUPANDEVERYTHING.md / SHARDING.md — safe to leave at
# defaults for a low-traffic admin console).
# WEB_REPLICA_COUNT=1
# ATLAS_CONNECTION_LIMIT=500
# MONGODB_WORKER_RESERVE=0
